rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Bills collection
    match /bills/{billId} {
      allow read: if true;
      allow create, update: if isValidId(billId) &&
        request.resource.data.keys().hasAll(['id', 'billNo', 'grandTotal', 'createdAt']) &&
        request.resource.data.id is string &&
        request.resource.data.billNo is string &&
        request.resource.data.billNo.size() <= 32 &&
        request.resource.data.grandTotal is number &&
        request.resource.data.grandTotal >= 0;
      allow delete: if isValidId(billId);
    }

    // Bakery Products catalog
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) &&
        request.resource.data.keys().hasAll(['id', 'nameEn', 'defaultRate']) &&
        request.resource.data.id is string &&
        request.resource.data.nameEn is string &&
        request.resource.data.nameEn.size() <= 120 &&
        request.resource.data.defaultRate is number &&
        request.resource.data.defaultRate >= 0;
      allow delete: if isValidId(productId);
    }

    // Shop settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) &&
        request.resource.data.shopName is string &&
        request.resource.data.shopName.size() <= 100;
    }

    // Customers CRM & Loyalty collection
    match /customers/{customerMobile} {
      allow read: if true;
      allow create, update: if isValidId(customerMobile) &&
        request.resource.data.keys().hasAll(['customerMobile', 'customerName']) &&
        request.resource.data.customerMobile is string &&
        request.resource.data.customerMobile.size() <= 32 &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() <= 120;
      allow delete: if isValidId(customerMobile);
    }
  }
}
